# Default Backend API Base URL
# - Local development: http://127.0.0.1:8000
# - Cloud deployment (e.g. Hugging Face Space): https://<username>-<spacename>.hf.space
# - Note: When deployed to Vercel, you can also attach tunnel links (ngrok, Cloudflare) directly via the in-app UI.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
